<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI for WiX v5:

    wix build packaging/windows/d3home.wxs -bindpath Bin=target/release -o d3home.msi

  Pinned to v5 on purpose. v6 introduced the Open Source Maintenance Fee and
  v7 refuses to run at all until its EULA has been accepted; see the release
  workflow.

  Windows has no shared icon directory and no man pages, so the package is
  the executable, its PATH entry, and nothing else: the icon already travels
  inside the .exe as a resource, put there by build.rs.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="d3home"
           Manufacturer="Demetri0"
           Version="0.1.0"
           UpgradeCode="24652DFA-AE10-55BF-A45F-24C40F31C449"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of d3home is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="d3home" />
    </StandardDirectory>

    <ComponentGroup Id="ProgramFiles" Directory="INSTALLFOLDER">
      <!-- One component, not two. A component needs a key path, and an
           Environment element cannot be one, so a PATH entry on its own
           would have had nothing to hang from. The GUID is left out
           entirely rather than written as a star, which was v3's way of
           asking for the generation that v4 and later do by default. -->
      <Component>
        <File Id="d3homeExe" Source="!(bindpath.Bin)\d3home.exe" KeyPath="yes" />
        <!-- A command line tool nobody can type is no use; this is what an
             installer is for on a platform with no /usr/local/bin. -->
        <Environment Id="UpdatePath" Name="PATH" Value="[INSTALLFOLDER]"
                     Permanent="no" Part="last" Action="set" System="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="d3home" Level="1">
      <ComponentGroupRef Id="ProgramFiles" />
    </Feature>
  </Package>
</Wix>
