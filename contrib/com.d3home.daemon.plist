<?xml version="1.0" encoding="UTF-8"?>
<!--
  A LaunchAgent, not a LaunchDaemon: an agent runs in the logged-in user's
  session, which is the only place a notification can appear.

    cp contrib/com.d3home.daemon.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.d3home.daemon.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.d3home.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/d3home</string>
        <string>daemon</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
</dict>
</plist>
